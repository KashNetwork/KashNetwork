# Copy to .env.local for local dev. Next.js loads it automatically.
# Any block left blank -> that adapter falls back to its fake.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_AFFILIATE_CODE=admin

# --- Database ---
# Blank -> local PGlite (embedded, no Docker), persisted to ./.pglite, auto-migrates.
# Set to a Postgres connection string (Supabase/Neon/...) for staging + production.
DATABASE_URL=

# On boot, if this profile isn't already an admin it's created/promoted.
# Local convenience only; for prod use `pnpm create-admin`.
SEED_ADMIN_EMAIL=admin@kash.network
SEED_ADMIN_PASSWORD=localdev123

# --- Explodely (payments) ---
EXPLODELY_API_KEY=
EXPLODELY_IPN_SECRET=
EXPLODELY_PRODUCT_ID=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM_HARLEY=harley@kash.network
EMAIL_FROM_SUPPORT=support@kash.network

# --- Email verification (video gate) ---
EMAIL_VERIFY_PROVIDER=fake
EMAIL_VERIFY_API_KEY=

# --- AI (email agent) ---
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_COST_CAP_USD=50

# --- Webhooks / cron ---
INBOUND_EMAIL_SECRET=
CRON_SECRET=

LEAD_SESSION_TTL_DAYS=3650
