# Copy to .env. Any block left blank -> that adapter falls back to its fake.

NODE_ENV=development
API_PORT=4000
PUBLIC_SITE_URL=https://kash.network
ADMIN_AFFILIATE_CODE=admin
# comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173

# On boot, if this profile isn't already an admin it's created/promoted.
# Local dev convenience — for staging/prod use `pnpm --filter @kash/api create-admin`.
SEED_ADMIN_EMAIL=admin@kash.network
SEED_ADMIN_PASSWORD=localdev123

# --- Database ---
# Leave DATABASE_URL blank for local dev -> uses PGlite (embedded Postgres,
# persisted to apps/api/.pglite, no Docker needed). Migrations auto-apply on boot.
# Set it to a Postgres connection string for staging/production.
DATABASE_URL=
# PGLITE_DIR=

# --- Explodely (PaymentProvider) ---
EXPLODELY_API_KEY=
EXPLODELY_IPN_SECRET=
EXPLODELY_PRODUCT_ID=

# --- Resend (EmailProvider) ---
RESEND_API_KEY=
EMAIL_FROM_HARLEY=harley@kash.network
EMAIL_FROM_SUPPORT=support@kash.network

# --- Email verification (video gate) ---
EMAIL_VERIFY_PROVIDER=fake        # fake | zerobounce | kickbox | ...
EMAIL_VERIFY_API_KEY=

# --- AI (AiProvider) ---
AI_PROVIDER=fake                  # fake | openai | google
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_COST_CAP_USD=50

# --- Inbound email webhook ---
INBOUND_EMAIL_SECRET=

# --- Cron auth (Vercel Cron sends this) ---
CRON_SECRET=

# --- Sessions ---
SESSION_COOKIE_SECRET=change-me-long-random
LEAD_SESSION_TTL_DAYS=3650
