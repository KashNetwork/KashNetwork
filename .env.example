# Copy to .env.local for local dev. Next.js loads it automatically.
# Any block left blank -> that adapter falls back to its fake.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_AFFILIATE_CODE=admin

# --- Database ---
# Blank -> local PGlite (embedded, no Docker), persisted to ./.pglite, auto-migrates.
# Set to a Postgres connection string (Supabase/Neon/...) for staging + production.
DATABASE_URL=

# On boot, if this profile isn't already an admin it's created/promoted.
# Local convenience only; for prod use `pnpm create-admin`.
SEED_ADMIN_EMAIL=admin@kash.network
SEED_ADMIN_PASSWORD=localdev123

# --- Explodely (payments) --- see docs/EXPLODELY-SETUP.md
EXPLODELY_USERNAME=
EXPLODELY_API_KEY=
# random string appended to the IPN URL as ?token= (Explodely doesn't sign IPNs)
EXPLODELY_IPN_SECRET=
EXPLODELY_PRODUCT_ID=
# EXPLODELY_CHECKOUT_BASE=https://explodely.com/p
# EXPLODELY_SKIP_VERIFY=1   # dev only

# --- Resend (email) ---
# Sending domains: go.kash.network (nurture) + app.kash.network (support/AI),
# both verified in Resend. See docs/EMAIL-SETUP.md.
RESEND_API_KEY=
EMAIL_FROM_HARLEY=Harley <harley@go.kash.network>
EMAIL_FROM_SUPPORT=Kash Support <support@app.kash.network>
SUPPORT_INBOX=support@app.kash.network

# --- Email verification (video gate) ---
EMAIL_VERIFY_PROVIDER=fake
EMAIL_VERIFY_API_KEY=

# --- AI (email agent) ---
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_COST_CAP_USD=50

# --- Webhooks / cron ---
INBOUND_EMAIL_SECRET=
# protects /api/cron/tick — Vercel Cron sends it as `Authorization: Bearer <value>`
CRON_SECRET=
# EXPLODELY_SKIP_VERIFY=1   # dev only — skip IPN signature check
# ALLOW_DEV_ROUTES=1        # allow /api/dev/* in production (do NOT set on real prod)

LEAD_SESSION_TTL_DAYS=3650
